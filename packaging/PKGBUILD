# Maintainer: Casey Shields <casey@shieldsworks.com>
pkgname=omaquill-git
_pkgname=omaquill
pkgver=0.1.0
pkgrel=1
pkgdesc='A writing studio for Omarchy that opens Scrivener projects'
arch=('x86_64' 'aarch64')
url='https://github.com/shieldsworks/omaquill'
license=('MIT')
depends=('gtk4' 'libadwaita')
makedepends=('cargo' 'git')
optdepends=('tex-gyre-fonts: close stand-ins for Palatino, Times and other Mac fonts')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf '%s.r%s.%s' "$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  cargo test --frozen --lib --test project --test compile
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/omaquill "$pkgdir/usr/bin/omaquill"
  install -Dm644 data/io.github.shieldsworks.Omaquill.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/io.github.shieldsworks.Omaquill.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 data/io.github.shieldsworks.Omaquill.mime.xml "$pkgdir/usr/share/mime/packages/omaquill.xml"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  # The Omarchy bar widget, for `omarchy plugin` to find.
  install -Dm644 manifest.json -t "$pkgdir/usr/share/omaquill/plugin/"
  install -Dm644 ui/WordsBar.qml -t "$pkgdir/usr/share/omaquill/plugin/ui/"
}
